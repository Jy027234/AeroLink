FROM node:22.23.2-bookworm-slim

ENV NODE_ENV=production

# The slim base has no CA bundle yet. Bootstrap from Debian's HTTP source;
# a mirror that redirects to HTTPS cannot be used before ca-certificates exists.
# APT still verifies Debian's signed metadata and package checksums.
ARG APT_MIRROR=http://deb.debian.org/debian

RUN sed -i "s|http://deb.debian.org/debian|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    chromium \
    dumb-init \
    fonts-liberation \
    fonts-noto-cjk \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libcurl4 \
    libdbus-1-3 \
    libdrm2 \
    libexpat1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libvulkan1 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxshmfence1 \
    libxss1 \
    wget \
    xdg-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Downloading Chrome from Google's CDN is unreliable from some cloud regions.
# Use Debian Chromium from the configured APT source instead.
ENV PUPPETEER_CACHE_DIR=/root/.cache/puppeteer
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Prisma verifies downloaded engine checksums. Use the reachable mirror during
# image builds so the database client remains reproducibly installable in CN.
ARG PRISMA_ENGINES_MIRROR=https://registry.npmmirror.com/-/binary/prisma
ENV PRISMA_ENGINES_MIRROR=${PRISMA_ENGINES_MIRROR}

ARG PRISMA_SCHEMA_PATH=prisma/schema.prisma
ENV PRISMA_SCHEMA_PATH=${PRISMA_SCHEMA_PATH}

COPY server/package*.json ./
COPY server/prisma ./prisma

RUN npm ci --include=dev \
  && npx prisma generate --schema "${PRISMA_SCHEMA_PATH}"

COPY server/ ./

RUN npm run build

COPY deploy/sqlite-legacy-backfill.sql ./deploy/sqlite-legacy-backfill.sql
COPY deploy/server-entrypoint.sh /usr/local/bin/server-entrypoint.sh
RUN chmod +x /usr/local/bin/server-entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["dumb-init", "--", "server-entrypoint.sh"]
